# API root in the shipped bundle: same-origin /api; no dev hostname.
VITE_API_BASE_URL=/api
# Development-only backend proxy; not included in the browser bundle.
API_PROXY_TARGET=http://127.0.0.1:8000
# Vite development listener.
DEV_HOST=127.0.0.1
DEV_PORT=5173
# Nginx container backend origin.
BACKEND_ORIGIN=http://backend:8000
# Browser journey server/credentials: used only by Playwright.
E2E_BASE_URL=http://127.0.0.1:5173
E2E_API_URL=http://127.0.0.1:8000
E2E_EMAIL=executive@ketsip.local
E2E_PASSWORD=
