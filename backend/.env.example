# Runtime mode; production disables API documentation.
APP_ENV=development
# Mongo server URI without database path; select the database separately.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=etsip
# Replace this dummy with a random 32+ character secret; dummy is rejected outside tests.
JWT_SECRET=dev-secret-change-in-production
# Eight-hour bearer lifetime.
JWT_EXPIRY_HOURS=8
# Comma-separated browser origins; optional for same-origin deployment.
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Insert missing demo accounts/roles only; never overwrite edits.
SEED_ON_STARTUP=true
# Demo passwords: 12–72 UTF-8 bytes. Change before exposing the service.
SEED_ADMIN_PASSWORD=ChangeAdmin123!
SEED_DEMO_PASSWORD=ChangeDemo123!
# Uvicorn bind configuration for containers/local development.
HOST=0.0.0.0
PORT=8000
